{
  "name": "phonelab",
  "version": "2.0.0",
  "description": "PHONELAB - Tone Generator, Noise Generator & Group Call",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "node --test test/link/*.test.js",
    "test:link": "node test/link/e2e.mjs && node test/link/ui.mjs && node test/link/rows.mjs",
    "test:tf": "node --test test/tenface/*.test.js",
    "test:tf:browser": "node test/tenface/audio.mjs && node test/tenface/ui.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
